// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Solo trabajamos con el schema "public"
  schemas  = ["public"]
}

// -------- Enums (public) --------
enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED

  @@schema("public")
}

// -------- Modelos (public) --------
model Workflow {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // Guardamos el UUID del user (sin FK real a auth.users)
  userId String? @db.Uuid

  runs Run[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Run {
  id String @id @default(uuid()) @db.Uuid

  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status     RunStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  log        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([status, finishedAt])
  @@schema("public")
}
