model Workflow {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String  @unique
  name        String
  description String?
  isActive    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
  runs      Run[]
  schedules Schedule[]

  @@index([userId, isActive])
  @@map("workflows")
}

model Task {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  key     String
  name    String
  type    String
  config  Json
  order   Int
  isEntry Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gatesFrom Gate[] @relation("FromTask")
  gatesTo   Gate[] @relation("ToTask")

  @@unique([workflowId, key])
  @@index([workflowId, order])
  @@map("tasks")
}

model Gate {
  id String @id @default(uuid()) @db.Uuid

  fromTaskId String @db.Uuid
  fromTask   Task   @relation("FromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)

  toTaskId String @db.Uuid
  toTask   Task   @relation("ToTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  condition String
  state     GateState @default(CLOSED)

  createdAt DateTime @default(now())

  @@index([fromTaskId])
  @@index([toTaskId])
  @@map("gates")
}

model Schedule {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  cron     String
  timezone String  @default("UTC")
  isActive Boolean @default(true)

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId, isActive])
  @@index([isActive, nextRunAt])
  @@map("schedules")
}

model Run {
  id           String    @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [key], onDelete: Cascade)
  status       RunStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?
  log          Json?
  spec         Json?
  meta         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workflowId])
  @@index([status, finishedAt])

  @@schema("public")
}
