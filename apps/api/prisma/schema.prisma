// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Solo trabajamos con el schema "public"
  schemas  = ["public"]
}

// -------- Enums (public) --------
enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
  CANCELLED

  @@schema("public")
}

// -----------------------
// Modelos (public schema)
// -----------------------
model Workflow {
  id        String @id @default(cuid())
  key       String @unique
  name      String
  userId    String?
  runs      Run[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Run {
  id           String    @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [key], onDelete: Cascade)
  status       RunStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?
  log          Json?
  spec         Json?
  meta         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workflowId])
  @@index([status, finishedAt])

  @@schema("public")
}
