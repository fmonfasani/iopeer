// =======================
// prisma/schema.prisma
// =======================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Necesario si usás auth.users de Supabase:
  schemas  = ["public", "auth"]
}

// -----------------------
// Enums
// -----------------------
enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

// -----------------------
// Modelos (auth schema)
// -----------------------
// Solo lo mínimo para poder relacionar Workflow -> User.
// Si no usás user/owner, podés borrar este modelo y los campos userId/user.
model User {
  id    String  @id @db.Uuid
  email String? // opcional, no se usa en relaciones

  @@map("users")
  @@schema("auth")
}

// -----------------------
// Modelos (public schema)
// -----------------------
model Workflow {
  id        String  @id @db.Uuid @default(uuid())
  name      String

  // Relación opcional con auth.users
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id])

  runs      Run[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Run {
  id         String     @id @db.Uuid @default(uuid())

  workflowId String     @db.Uuid
  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status     RunStatus  @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  log        Json?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([workflowId])
  @@index([status, finishedAt])
}
