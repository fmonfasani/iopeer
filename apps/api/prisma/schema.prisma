// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Solo trabajamos con el schema "public"
  schemas  = ["public"]
}

// -------- Enums (public) --------
enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
  CANCELLED

  @@schema("public")
}

// -----------------------
// Modelos (auth schema)
// -----------------------
// Solo lo mínimo para poder relacionar Workflow -> User.
// Si no usás user/owner, podés borrar este modelo y los campos userId/user.
model User {
  id    String  @id @db.Uuid
  email String? // opcional, no se usa en relaciones

  workflows Workflow[]

  @@map("users")
  @@schema("auth")
}

// -----------------------
// Modelos (public schema)
// -----------------------
model Workflow {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // Guardamos el UUID del user (sin FK real a auth.users)
  userId String? @db.Uuid

  runs Run[]

  @@schema("public")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Run {
  id         String     @id @db.Uuid @default(uuid())

  workflowId String     @db.Uuid
  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status     RunStatus  @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  log        Json?

  //  nuevas
  spec       Json?
  meta       Json?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([workflowId])
  @@index([status, finishedAt])
}
