{
  "version": "1.0",
  "plan": "iopeer-bootstrap",
  "createdAt": "2025-10-05T14:59:44Z",
  "policy": {
    "order": "ascending",
    "retry": { "max": 3, "strategy": "exponential", "baseMs": 2000 },
    "promote": { "windowMinutes": 60, "slo": { "errorRatePct": 1, "p95Ms": 600 } },
    "gates": {
      "L2_requires": ["L1"],
      "L3_requires": ["L2"],
      "L4_requires": ["L3"],
      "L5_requires": ["L4"]
    }
  },
  "levels": ["L1","L2","L3","L4","L5"],
  "schedule": [
    {
      "id": "L1-HEALTH",
      "level": "L1",
      "workflowId": "wf.health",
      "workflowUuid": "7f1f9e2e-2b66-4c2e-a1d4-8a7b7e9b3c01",
      "description": "Verifica que la API está viva y DB accesible.",
      "pre": ["env:API_PORT","db:reachable"],
      "nodes": [
        { "id": "n1", "type": "echo", "params": { "message": "Boot L1" } },
        { "id": "n2", "type": "http", "params": { "url": "http://api:3001/health", "expect": { "status": 200 } } }
      ]
    },
    {
      "id": "L2-PRISMA",
      "level": "L2",
      "workflowId": "wf.prisma.migrate",
      "workflowUuid": "0a7f3c9b-6e15-4a2d-9d6a-2e1b4f3a9c02",
      "description": "Aplica migraciones Prisma al schema core.",
      "pre": ["L1-HEALTH:SUCCEEDED"],
      "nodes": [
        { "id": "n1", "type": "echo", "params": { "message": "Applying Prisma migrations" } },
        { "id": "n2", "type": "shell", "params": { "cmd": "pnpm -C apps/api prisma migrate deploy" } }
      ]
    },
    {
      "id": "L3-RUNNER",
      "level": "L3",
      "workflowId": "wf.runner.basic",
      "workflowUuid": "e3b2c5d6-7a89-4b01-9c23-4d5e6f7a8b03",
      "description": "Valida cola in-memory y ejecución básica de runs.",
      "pre": ["L2-PRISMA:SUCCEEDED"],
      "nodes": [
        { "id": "n1", "type": "delay", "params": { "ms": 500 } },
        { "id": "n2", "type": "echo", "params": { "message": "Queue up" } },
        { "id": "n3", "type": "http", "params": { "url": "http://api:3001/runs/test", "method": "POST", "body": { "dryRun": true }, "expect": { "status": 200 } } }
      ]
    },
    {
      "id": "L4-QUALITY",
      "level": "L4",
      "workflowId": "wf.quality",
      "workflowUuid": "12c4d6e8-90ab-4cde-b123-4567abcd8904",
      "description": "Ejecuta tests y verifica SLOs básicos.",
      "pre": ["L3-RUNNER:SUCCEEDED"],
      "nodes": [
        { "id": "n1", "type": "shell", "params": { "cmd": "pnpm -C apps/api test" } },
        { "id": "n2", "type": "metrics.assert", "params": { "p95MsMax": 600, "errorRatePctMax": 1 } }
      ]
    },
    {
      "id": "L5-DELIVERY",
      "level": "L5",
      "workflowId": "wf.delivery",
      "workflowUuid": "98ba7654-3210-4fed-ba98-76543210dc05",
      "description": "Hace deploy canary, observa y promueve si SLO OK; rollback si falla.",
      "pre": ["L4-QUALITY:SUCCEEDED"],
      "nodes": [
        { "id": "n1", "type": "http", "params": { "url": "http://ci/canary/deploy", "method": "POST", "body": { "env": "canary" }, "expect": { "status": 200 } } },
        { "id": "n2", "type": "delay", "params": { "ms": 3600000 } },
        { "id": "n3", "type": "slo.check", "params": { "windowMin": 60, "p95MsMax": 600, "errorRatePctMax": 1 } },
        { "id": "n4", "type": "http", "params": { "url": "http://ci/promote", "method": "POST", "body": { "from": "canary", "to": "prod" }, "expect": { "status": 200 } } }
      ],
      "onFail": [
        { "type": "http", "params": { "url": "http://ci/rollback", "method": "POST", "body": { "to": "previous" } } },
        { "type": "slack.notify", "params": { "channel": "#iopeer-alerts", "message": "Rollback executed from plan-bootstrap" } }
      ]
    }
  ],
  "connectors": {
    "echo": { "kind": "builtin" },
    "delay": { "kind": "builtin" },
    "http": { "kind": "builtin" },
    "shell": { "kind": "restricted" },
    "metrics.assert": { "kind": "builtin" },
    "slo.check": { "kind": "builtin" },
    "slack.notify": { "kind": "builtin", "secret_ref": "SLACK_WEBHOOK_URL" }
  }
}
