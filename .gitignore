.env
# ----------------------------------------------------------------------
# 1. Dependencias y Monorepo
# ----------------------------------------------------------------------
# pnpm
/node_modules
/pnpm-lock.yaml
/pnpm-store # No siempre usado, pero buena práctica si el store está en el repo

# Artifactos de Build
dist/
build/
.next/
out/
.turbo/  # Si usas Turborepo (altamente recomendado para monorepos)
# ignora los node_modules en todas las apps y packages
apps/*/node_modules
packages/*/node_modules

# ----------------------------------------------------------------------
# 2. Entorno y Secrets
# ----------------------------------------------------------------------
# Variables de entorno
.env
.env.local
.env.*.local

# Archivos de Next.js (siempre ignorar)
.next/

# ----------------------------------------------------------------------
# 3. Docker y Contenedores
# ----------------------------------------------------------------------
# Ignorar logs, archivos temporales de contenedores y binarios
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker Compose logs y archivos generados
.docker
!docker-compose.yml # Asegúrate de NO ignorar el archivo principal

# ----------------------------------------------------------------------
# 4. Artefactos de OS y Herramientas Comunes
# ----------------------------------------------------------------------
# macOS
.DS_Store

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history

# TypeScript
# Ignorar archivos de mapeo de fuente y artefactos de compilación
*.tsbuildinfo
tsconfig.tsbuildinfo

# Prisma
# Ignorar el cliente generado
/packages/db/prisma/client/
/generated/prisma
