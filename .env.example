# Example environment variables for local development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/iopeer"
PORT=3001
LOG_LEVEL=info
SCHEDULER_INTERVAL_MS=60000
HTTP_STEP_TIMEOUT_MS=10000

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario@gmail.com
SMTP_PASS=tu_password_o_app_password
REPORT_EMAIL_FROM="IOpeer Reports <tu_usuario@gmail.com>"
REPORT_EMAIL_TO=fmonfasani@gmail.com

# Cron (opcional): 9 AM Buenos Aires
REPORT_CRON=0 12 * * *

# Sourcegraph Cloud
SG_ENDPOINT=https://sourcegraph.com/.api/graphql
SG_TOKEN=<tu_token_sourcegraph>          # opcional si el repo es 100% público; si lo tenés, mejor
SG_REPO=github.com/<owner>/<repo>        # ej: github.com/fede/iopeer
SG_DAYS_COMMITS=7                        # ventana para commits recientes
SG_DAYS_DIFFS=30                         # ventana para diffs/archivos más cambiados

# Slack (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

